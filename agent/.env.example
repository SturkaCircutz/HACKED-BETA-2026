# Server-side only. Never use VITE_* for these secrets or commit agent/.env.
# Create a free developer key at https://console.groq.com/keys
GROQ_API_KEY=
ECO311_MODEL=openai/gpt-oss-20b

# Optional: request access at https://311.edmonton.ca/open311/app_requests/new
# This module only reads Open311. It never creates a City service request.
OPEN311_API_KEY=

# Optional: pedestrian route estimates. Without this, proximity is labelled approximate.
ORS_API_KEY=

# Optional: Socrata application token for City open-data requests.
SOCRATA_APP_TOKEN=

# Optional key for the standalone API; send it as X-Eco311-Key.
# When mounting the router, reuse the existing backend auth dependency instead.
ECO311_API_KEY=
ECO311_OFFLINE=0
ECO311_LLM_TIMEOUT=12
# ECO311_DB_PATH=/absolute/path/to/database/eco311.sqlite3
