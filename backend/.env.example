# Copy to .env and fill in. Everything is optional for local dev.
DATABASE_URL=sqlite:///./data/app.db
# LLM_MODEL=openai:gpt-4o-mini            # or anthropic:claude-sonnet-5-5 ; empty = offline fallbacks
# VISION_MODEL=
# EMBEDDING_MODEL=openai:text-embedding-3-small
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TAVILY_API_KEY=
# GOOGLE_MAPS_API_KEY=
EMAIL_BACKEND=console
STORAGE_BACKEND=local
PUBLIC_BASE_URL=http://localhost:8000
# JWT_SECRET=                              # empty = dev auth via X-User-Id header
